{
  "name": "@tormnator/nue-glow",
  "version": "0.2.5-tor.1",
  "description": "Markdown syntax highlighter for CSS developers",
  "homepage": "https://nuejs.org/blog/introducing-glow/",
  "license": "MIT",
  "type": "module",

  "repository": {
    "url": "https://github.com/tormnator/nue",
    "directory": "packages/nueglow",
    "type": "git"
  },
  "publishConfig": {
